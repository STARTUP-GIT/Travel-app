# Google Maps API key for native Android/iOS map rendering.
# Maps SDK for Android must be enabled in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Optional: override the walking routing service used for online RETURN TO START.
# Defaults to the free public OSRM demo server (no key required).
# EXPO_PUBLIC_ROUTING_BASE_URL=https://router.project-osrm.org
