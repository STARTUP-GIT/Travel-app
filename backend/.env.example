# ==============================================================================
# Atlas Wanders Backend - Environment Configuration Example
# Duplicate this file as .env in the backend directory and supply your values.
# ==============================================================================

# Server Port
PORT=8080
NODE_ENV=production

# Database Connection (PostgreSQL)
# For local Docker Compose, the service name is 'db':
# DATABASE_URL="postgresql://postgres:postgres@db:5432/atlaswanders?schema=public"
# For external/cloud hosted PostgreSQL (Neon, Supabase, RDS, etc.):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlaswanders?schema=public"

# Allowed CORS Origins (Client Web, Admin Web, Service/Partner Web)
CLIENTENDURL=https://atlaswanders.com
ADMINENDURL=https://admin.atlaswanders.com
SERVICEENDURL=https://partner.atlaswanders.com

# Authentication Secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Cloudinary (Media Storage & Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Resend (Transactional Email Service)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@atlaswanders.com

