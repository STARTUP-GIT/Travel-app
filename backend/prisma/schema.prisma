// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model app_config{
  id                  String   @id @default(uuid())
  app_name            String
  imageBanners        String[]
  icon                String
  webTitle            String
  text                String
  contacts            String
  termsandconditions  String
  privacy             String
  app_description     String
  testimonials        testimonials[]
  admin               admin[]
}

model testimonials{
  id          String     @id @default(uuid())
  userId      String
  appConfigId String
  user        user       @relation(fields: [userId], references: [id])
  specificguideId String?
  specificguide specific_guide? @relation(fields: [specificguideId], references: [id])
  commonGuideId String?
  commonGuide common_guide? @relation(fields: [commonGuideId], references: [id])
  appConfig   app_config? @relation(fields: [appConfigId], references: [id])
  text        String
  image       String?
  rating      Float
}

model admin{
  id            String   @id @default(uuid())
  name          String 
  username      String   @unique
  email         String   @unique
  password      String   
  appConfigId   String?
  appConfig   app_config? @relation(fields: [appConfigId], references: [id])
  authprovider      authProviders
  profilepic    String?
}

model user {
  id            String   @id @default(uuid())
  name          String 
  username      String   @unique
  email         String   @unique
  password      String?   
  phonenumber   String
  profilepic    String?
  authprovider      authProviders?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user_fav_place  user_fav_place[]
  testimonials    testimonials[]
  hotel_booking   hotel_booking[]
  restaurant_reservation restaurant_reservation[]
  specificGuideBookings specific_guide_booking[]
  commonGuideBookings common_guide_booking[]
}

model user_fav_place {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  user      user     @relation(fields: [userId], references: [id])
  place     place    @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
}

model country {
  id        String   @id @default(uuid())
  name      String
  states    state[]
  isServiceAvailable Boolean  @default(false)
}

model state {
  id        String   @id @default(uuid())
  name      String
  countryId String
  country   country  @relation(fields: [countryId], references: [id])
  districts district[]
  isServiceAvailable Boolean  @default(false)
}

model district {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  state     state    @relation(fields: [stateId], references: [id])
  places    place[]
  hotels    hotel[]
  restaurent  restaurent[]
  isServiceAvailable Boolean  @default(false)
  autoApprovePlaces   Boolean  @default(false)
  placeSubmissions place_submission[]
}

model place {
  id              String   @id @default(uuid())
  name            String
  description     String
  districtId      String
  images          String[]
  specificguide   specific_guide[]
  commonGuidePlaces common_guide_places[]
  placeSubmissions place_submission[]
  specificGuideBookings specific_guide_booking[]
  commonGuideBookingPlaces common_guide_booking_places[]
  entryfee        Float
  category        String
  status          placeSubmissionStatus @default(PENDING)
  latitude        Float
  longitude       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  district        district @relation(fields: [districtId], references: [id])
  user_fav_place  user_fav_place[]
}

model place_submission {
  id              String   @id @default(uuid())
  placeId         String?
  name            String
  description     String
  districtId      String
  images          String[]
  entryfee        Float
  category        String
  latitude        Float
  longitude       Float
  status          placeSubmissionStatus @default(PENDING)
  rejectionReason String?
  specificGuideId String?
  commonGuideId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  place           place? @relation(fields: [placeId], references: [id])
  district        district @relation(fields: [districtId], references: [id])
  specificGuide   specific_guide? @relation(fields: [specificGuideId], references: [id])
  commonGuide     common_guide? @relation(fields: [commonGuideId], references: [id])
}

model specific_guide {
  id              String     @id  @default(uuid())
  full_name       String
  username        String      @unique
  email           String      @unique
  password        String?
  phonenumber     String
  profile_pic     String?
  tagline         String?
  authprovider        authProviders
  review          String[]
  rating          Float?
  description     String?
  placeid         String
  place           place @relation(fields: [placeid], references: [id])
  testimonials    testimonials[]
  placeSubmissions place_submission[]
  bookings        specific_guide_booking[]
  
  isReported      Boolean @default(false)
  experience      Int
  cost            Int
  language        String[]
   createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
} 
model common_guide {
  id              String     @id  @default(uuid())
  full_name       String
  username        String      @unique
  email           String      @unique
  password        String
  phonenumber     String
  profile_pic     String
  tagline         String?
  authprovider        authProviders
  review          String[]
  rating          Float?
  description     String?
  places          common_guide_places[]
  isReported      Boolean @default(false)
  experience      Int
  cost            Int
  language        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
    testimonials    testimonials[]
  placeSubmissions place_submission[]
  bookings        common_guide_booking[]

} 

model common_guide_places {
  id            String       @id @default(uuid())
  placeId       String
  commonGuideId String

  place        place        @relation(fields: [placeId], references: [id])
  commonGuide  common_guide @relation(fields: [commonGuideId], references: [id])

  @@unique([placeId, commonGuideId])
}

model specific_guide_booking {
  id              String   @id @default(uuid())
  userId          String
  specificGuideId String
  placeId         String
  bookingDate     DateTime
  bookingTime     String?
  status          bookingStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specificGuide   specific_guide @relation(fields: [specificGuideId], references: [id], onDelete: Cascade)
  place           place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model common_guide_booking {
  id            String   @id @default(uuid())
  userId        String
  commonGuideId String
  bookingDate   DateTime
  bookingTime   String?
  status        bookingStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commonGuide   common_guide @relation(fields: [commonGuideId], references: [id], onDelete: Cascade)
  selectedPlaces common_guide_booking_places[]
}

model common_guide_booking_places {
  id        String   @id @default(uuid())
  bookingId String
  placeId   String
  booking   common_guide_booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  place     place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([bookingId, placeId])
}

model hotel {
  id                    String    @id @default(uuid())
  name                  String
  address               String
  profile_logo          String
  districtId            String
  description           String?
  rating                Float
  review                String[]
  cost_per_night        Int
  images                String[]
  latitude              Float
  longitude             Float
  phone_number          String?
  whatsapp_number       String?
  email                 String?
  website               String?
  booking_enabled       Boolean   @default(true)
  status                placeSubmissionStatus @default(PENDING)
  hotelOwnerId          String
  hotelOwner            hotel_owner @relation(fields: [hotelOwnerId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  district              district @relation(fields: [districtId], references: [id])
  bookings              hotel_booking[]
}

model  restaurent {
  id                    String    @id @default(uuid())
  name                  String
  address               String
  districtId            String
  description           String?
  rating                Float
  review                String[]
  menu                  String[]
  food_category         Food_Category @default(VEG_AND_NONVEG)
  images                String[]
  profile_logo          String
  latitude              Float
  longitude             Float
  phone_number          String?
  whatsapp_number       String?
  email                 String?
  website               String?
  booking_enabled       Boolean   @default(true)
  status                placeSubmissionStatus @default(PENDING)
  restaurentOwnerId     String
  restaurentOwner       restaurent_owner @relation(fields: [restaurentOwnerId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  district              district @relation(fields: [districtId], references: [id])
  reservations          restaurant_reservation[]
}

model hotel_owner {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  phone_number  String
  profile_pic   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hotels        hotel[]
}

model restaurent_owner {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  phone_number  String
  profile_pic   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  restaurents   restaurent[]
}

model hotel_booking {
  id            String      @id @default(uuid())
  hotelId       String
  userId        String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int
  totalAmount   Float
  status        bookingStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  hotel         hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model restaurant_reservation {
  id            String      @id @default(uuid())
  restaurantId  String
  userId        String
  reservationDate DateTime
  guests        Int
  status        bookingStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurent    restaurent  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

