enum authProviders{
  GOOGLE
  EMAIL
}

enum bookingStatus{
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum placeSubmissionStatus{
  PENDING
  APPROVED
  REJECTED
}


