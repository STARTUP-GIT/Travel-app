// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model app_config{
  id                  String        @id @default(uuid())
  // CLIENT = customer web + mobile; SERVICE = service web + mobile.
  // Existing rows (created before this column) are treated as CLIENT.
  scope               BrandingScope @default(CLIENT)
  app_name            String
  imageBanners        String[]
  icon                String
  webTitle            String
  text                String
  contacts            String
  termsandconditions  String
  privacy             String
  app_description     String
  testimonials        testimonials[]
  admin               admin[]

  // Global approval policy, toggled by the admin panel. When a flag is on, a
  // new record of that type is created APPROVED instead of PENDING. The backend
  // reads these on every creation flow, so the setting cannot be bypassed by a
  // caller that manipulates the frontend. Defaults to off: nothing is
  // auto-approved until an admin deliberately turns it on.
  placesAutoApproval      Boolean  @default(false)
  guidesAutoApproval      Boolean  @default(false)
  hotelsAutoApproval      Boolean  @default(false)
  restaurantsAutoApproval Boolean  @default(false)
}

model testimonials{
  id          String     @id @default(uuid())
  userId      String
  appConfigId String
  user        user       @relation(fields: [userId], references: [id])
  specificguideId String?
  specificguide specific_guide? @relation(fields: [specificguideId], references: [id])
  commonGuideId String?
  commonGuide common_guide? @relation(fields: [commonGuideId], references: [id])
  appConfig   app_config? @relation(fields: [appConfigId], references: [id])
  text        String
  image       String?
  rating      Float
}

model admin{
  id            String      @id @default(uuid())
  name          String 
  username      String      @unique
  email         String      @unique
  password      String   
  appConfigId   String?
  appConfig     app_config? @relation(fields: [appConfigId], references: [id])
  authprovider  authProviders
  profilepic    String?
  // Role-based access: SUPER can access everything; VIEWER is read-only.
  // Defaults to SUPER so existing admin accounts are unaffected.
  role          AdminRole   @default(SUPER)
  isSuspended   Boolean     @default(false)
  audit_logs    audit_log[]
  sessions      admin_session[]
}

model user {
  id            String   @id @default(uuid())
  name          String 
  username      String   @unique
  email         String   @unique
  password      String?   
  phonenumber   String
  profilepic    String?
  authprovider      authProviders?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user_fav_place  user_fav_place[]
  testimonials    testimonials[]
  hotel_booking   hotel_booking[]
  restaurant_reservation restaurant_reservation[]
  specificGuideBookings specific_guide_booking[]
  commonGuideBookings common_guide_booking[]
}

model user_fav_place {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  user      user     @relation(fields: [userId], references: [id])
  place     place    @relation(fields: [placeId], references: [id])

  @@unique([userId, placeId])
}

model country {
  id        String   @id @default(uuid())
  name      String
  states    state[]
  isServiceAvailable Boolean  @default(false)
}

model state {
  id                  String    @id @default(uuid())
  name                String
  countryId           String
  country             country   @relation(fields: [countryId], references: [id])
  districts           district[]
  isServiceAvailable  Boolean   @default(false)
  primaryImage        String?
}

model district {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  state     state    @relation(fields: [stateId], references: [id])
  places    place[]
  hotels    hotel[]
  restaurent  restaurent[]
  isServiceAvailable Boolean  @default(false)
  autoApprovePlaces   Boolean  @default(false)
  placeSubmissions place_submission[]
}

model place {
  id              String   @id @default(uuid())
  name            String
  description     String
  districtId      String
  images          String[]
  specificguide   specific_guide[]
  commonGuidePlaces common_guide_places[]
  commonGuidePackagePlaces common_guide_package_places[]
  placeSubmissions place_submission[]
  specificGuideBookings specific_guide_booking[]
  commonGuideBookingPlaces common_guide_booking_places[]
  entryfee        Float?
  category        String
  status          placeSubmissionStatus @default(PENDING)
  pricing         place_pricing[]
  latitude        Float
  longitude       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  district        district @relation(fields: [districtId], references: [id])
  user_fav_place  user_fav_place[]
}

/**
 * One ticket band of a place: who it is for and what they pay.
 *
 * `place.entryfee` stays the single flat price, so a place with one fee, a free
 * place, and every place created before this table existed are all still read
 * exactly as before. This table only exists for the places that genuinely charge
 * different amounts per band, and a place with no rows simply keeps using
 * `entryfee`. It is a real relation rather than a packed string, so the same rows
 * drive the service form, the customer place page and the admin place screens.
 */
model place_pricing {
  id        String             @id @default(uuid())
  placeId   String
  visitor   placeVisitorType
  /// Free text on purpose: the bands a real attraction uses differ per place
  /// (Adult / Child / Senior Citizen / Student / Infant / Foreigner …), so the
  /// set cannot be a fixed enum without a migration every time one is added.
  ageGroup  String
  amount    Float

  place     place              @relation(fields: [placeId], references: [id], onDelete: Cascade)

  // The same band cannot be listed twice for one place; the same band may of
  // course exist for any number of different places.
  @@unique([placeId, visitor, ageGroup])
  @@index([placeId])
}

model place_submission {
  id              String   @id @default(uuid())
  placeId         String?
  name            String
  description     String
  districtId      String
  images          String[]
  entryfee        Float?
  category        String
  latitude        Float
  longitude       Float
  // Pending ticket bands, stored the same way this row already stores the
  // pending name, description and fee: as the snapshot awaiting review. It is
  // NOT a second source of truth — the live bands are always `place_pricing`,
  // and approving a submission copies this snapshot across. Null means the
  // submission changes no pricing, which is what every submission created
  // before this column existed means.
  pricing         Json?
  status          placeSubmissionStatus @default(PENDING)
  rejectionReason String?
  specificGuideId String?
  commonGuideId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  place           place? @relation(fields: [placeId], references: [id])
  district        district @relation(fields: [districtId], references: [id])
  specificGuide   specific_guide? @relation(fields: [specificGuideId], references: [id])
  commonGuide     common_guide? @relation(fields: [commonGuideId], references: [id])
}

model specific_guide {
  id              String     @id  @default(uuid())
  full_name       String
  username        String      @unique
  email           String      @unique
  password        String?
  phonenumber     String
  profile_pic     String?
  tagline         String?
  authprovider        authProviders
  review          String[]
  rating          Float?
  description     String?
  // Nullable because a place guide may register before choosing a place: the
  // place is their decision and can be added later. Still a single place, never
  // a list — that rule is the scalar column itself.
  placeid         String?
  place           place? @relation(fields: [placeid], references: [id])
  testimonials    testimonials[]
  placeSubmissions place_submission[]
  bookings        specific_guide_booking[]
  
  isReported      Boolean @default(false)
  experience      Int
  cost            Int
  language        String[]

  // Opt-in customer location sharing for Specific Guide
  isSharingLocation Boolean   @default(false)
  sharedLatitude    Float?
  sharedLongitude   Float?
  locationUpdatedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // PENDING until an admin approves the guide, or APPROVED straight away at
  // signup when the guides auto-approval setting is on.
  status          placeSubmissionStatus @default(PENDING)
} 
model common_guide {
  id              String     @id  @default(uuid())
  full_name       String
  username        String      @unique
  email           String      @unique
  password        String
  phonenumber     String
  profile_pic     String
  tagline         String?
  // Optional trading name for the guide's agency, e.g. "Mysuru Heritage Tours".
  agencyName      String?
  agencyAddress   String?
  agencyBanner    String?
  agencyMapsUrl   String?
  authprovider        authProviders
  review          String[]
  rating          Float?
  description     String?
  places          common_guide_places[]
  packages        common_guide_package[]
  isReported      Boolean @default(false)
  experience      Int
  cost            Int
  language        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  testimonials    testimonials[]
  placeSubmissions place_submission[]
  bookings        common_guide_booking[]

  // PENDING until an admin approves the guide, or APPROVED straight away at
  // signup when the guides auto-approval setting is on.
  status          placeSubmissionStatus @default(PENDING)

} 

model common_guide_places {
  id            String       @id @default(uuid())
  placeId       String
  commonGuideId String

  place        place        @relation(fields: [placeId], references: [id])
  commonGuide  common_guide @relation(fields: [commonGuideId], references: [id], onDelete: Cascade)

  @@unique([placeId, commonGuideId])
}

model common_guide_package {
  id            String   @id @default(uuid())
  commonGuideId String
  name          String
  description   String?
  pricingMode   String   @default("WHOLE_TOUR")
  pricingUnit   String   @default("PER_TOUR")
  price         Float    @default(0)
  allowCustomerPlaceSelection Boolean @default(true)
  cancellationPolicy String?
  foodStatus        String   @default("EXCLUDED")
  foodDetails       String?
  transportStatus   String   @default("EXCLUDED")
  transportDetails  String?
  entryFeeStatus    String   @default("EXCLUDED")
  entryFeeDetails   String?
  additionalCostsDetails String?
  tripStartTime String?
  pickupName    String?
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?
  pickupMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commonGuide common_guide @relation(fields: [commonGuideId], references: [id], onDelete: Cascade)
  places      common_guide_package_places[]
  bookings    common_guide_booking[]

  @@index([commonGuideId])
}

model common_guide_package_places {
  id        String @id @default(uuid())
  packageId String
  placeId   String
  price     Float?

  package common_guide_package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  place   place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([packageId, placeId])
  @@index([placeId])
}

model specific_guide_booking {
  id              String   @id @default(uuid())
  userId          String
  specificGuideId String
  placeId         String
  bookingDate     DateTime
  bookingTime     String?
  numberOfPeople  Int      @default(1)
  totalPrice      Float    @default(0)
  pickupName      String?
  pickupAddress   String?
  pickupLat       Float?
  pickupLng       Float?
  pickupMapsUrl   String?
  requestedPickupName String?
  requestedPickupAddress String?
  requestedPickupMapsUrl String?
  cancellationPolicy String?
  paymentStatus   String   @default("NOT_VERIFIED")
  rescheduleStatus String  @default("NONE")
  requestedBookingDate DateTime?
  requestedBookingTime String?
  status          bookingStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specificGuide   specific_guide @relation(fields: [specificGuideId], references: [id], onDelete: Cascade)
  place           place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model common_guide_booking {
  id                      String   @id @default(uuid())
  userId                  String
  commonGuideId           String
  packageId               String?
  package                 common_guide_package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  bookingDate             DateTime
  bookingTime             String?
  numberOfPeople          Int      @default(1)
  totalPrice              Float    @default(0)
  pricingMode             String   @default("WHOLE_TOUR")
  pricingUnit             String   @default("PER_TOUR")
  allowCustomerPlaceSelection Boolean @default(true)
  cancellationPolicy      String?
  foodStatus              String?
  foodDetails             String?
  transportStatus         String?
  transportDetails        String?
  entryFeeStatus          String?
  entryFeeDetails         String?
  additionalCostsDetails  String?
  paymentStatus           String   @default("NOT_VERIFIED")
  rescheduleStatus        String   @default("NONE")
  requestedBookingDate    DateTime?
  requestedBookingTime    String?
  tripStartTime           String?
  pickupName              String?
  pickupAddress           String?
  pickupLat               Float?
  pickupLng               Float?
  pickupMapsUrl           String?
  pickupRequestStatus     String   @default("DEFAULT")
  requestedPickupName     String?
  requestedPickupAddress  String?
  requestedPickupMapsUrl  String?
  requestedPickupLat      Float?
  requestedPickupLng      Float?
  status                  bookingStatus @default(PENDING)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commonGuide             common_guide @relation(fields: [commonGuideId], references: [id], onDelete: Cascade)
  selectedPlaces          common_guide_booking_places[]
}

model common_guide_booking_places {
  id        String   @id @default(uuid())
  bookingId String
  placeId   String
  booking   common_guide_booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  place     place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([bookingId, placeId])
}

model hotel {
  id                    String    @id @default(uuid())
  name                  String
  address               String
  profile_logo          String
  districtId            String
  description           String?
  rating                Float
  review                String[]
  cost_per_night        Int
  images                String[]
  latitude              Float
  longitude             Float
  phone_number          String?
  whatsapp_number       String?
  email                 String?
  website               String?
  booking_enabled       Boolean   @default(true)
  status                placeSubmissionStatus @default(PENDING)
  hotelOwnerId          String
  hotelOwner            hotel_owner @relation(fields: [hotelOwnerId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  district              district @relation(fields: [districtId], references: [id])
  bookings              hotel_booking[]
}

model  restaurent {
  id                    String    @id @default(uuid())
  name                  String
  address               String
  districtId            String
  description           String?
  rating                Float
  review                String[]
  menu                  String[]
  food_category         Food_Category @default(VEG_AND_NONVEG)
  images                String[]
  profile_logo          String
  latitude              Float
  longitude             Float
  phone_number          String?
  whatsapp_number       String?
  email                 String?
  website               String?
  booking_enabled       Boolean   @default(true)
  status                placeSubmissionStatus @default(PENDING)
  restaurentOwnerId     String
  restaurentOwner       restaurent_owner @relation(fields: [restaurentOwnerId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  district              district @relation(fields: [districtId], references: [id])
  reservations          restaurant_reservation[]
}

model hotel_owner {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  phone_number  String
  profile_pic   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hotels        hotel[]
}

model restaurent_owner {
  id            String   @id @default(uuid())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  phone_number  String
  profile_pic   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  restaurents   restaurent[]
}

model hotel_booking {
  id            String      @id @default(uuid())
  hotelId       String
  userId        String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int
  rooms         Int
  totalAmount   Float
  status        bookingStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  hotel         hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model restaurant_reservation {
  id            String      @id @default(uuid())
  restaurantId  String
  userId        String
  reservationDate DateTime
  guests        Int
  status        bookingStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurent    restaurent  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

