# ---------------------------------------------------------------------------
# Customer mobile app — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values for your deployment.
#
#   cp .env.example .env
#
# `.env` is git-ignored (see .gitignore) and must never be committed.
#
# Only PUBLIC client configuration belongs here. No secret, API key with write
# scope, JWT secret or database URL should ever be placed in this project: the
# mobile bundle is shipped to end users and is fully readable.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# REQUIRED — backend
# ---------------------------------------------------------------------------
# Base URL of the SAME Express backend the customer web frontend uses.
# No trailing slash. Must be https:// for release builds.
#
#   e.g. https://api.example.com
#
# The app fails loudly (a friendly configuration screen) rather than silently
# querying the wrong host if this is missing.


# ---------------------------------------------------------------------------
# REQUIRED — Google Sign-In
# ---------------------------------------------------------------------------
# Web client id from Google Cloud Console → "OAuth client ID" → "Web application".
# This is public by design (it identifies your app, it does not authorise it).
#
# Do NOT put the *client secret* here. The mobile app never sees it.
#
# The placeholder below is safe to build and run with: Google Sign-In stays
# visible, and tapping it shows "Google Sign-In is temporarily unavailable.
# Please try again later." instead of starting an OAuth request that Google would
# reject. Replace it with the real id to switch the existing flow back on — no
# other change is needed.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com


# ---------------------------------------------------------------------------
# OPTIONAL — public client configuration
# ---------------------------------------------------------------------------
# Custom URL scheme used for the OAuth redirect and deep links.
# Must match `scheme` in app.json.
EXPO_PUBLIC_APP_SCHEME=karnatakatourism


# ---------------------------------------------------------------------------
# OPTIONAL — Google Maps (Android)
# ---------------------------------------------------------------------------
# Only needed if you enable the in-app `react-native-maps` view for the Path
# Tracker. The customer app's map cards otherwise use deep links that require no
# key at all.
