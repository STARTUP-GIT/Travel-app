{
  "expo": {
    "name": "AtlasWanders",
    "slug": "atlaswanders",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "scheme": "atlaswanders",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D50BE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlaswanders",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show how far away a destination is and to record your trip with Path Tracker.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Path Tracker records your trip in the background so distance and duration stay accurate while your screen is off.",
        "NSPhotoLibraryUsageDescription": "Choose a photo to use as your profile picture.",
        "NSCameraUsageDescription": "Take a photo to use as your profile picture.",
        "NSLocationTemporaryUsageDescriptionDictionary": {
          "TripTracking": "Used while Path Tracker records an active trip."
        }
      }
    },
    "android": {
      "package": "com.atlaswanders",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#2D50BE",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCfZlnNz51BCxehQ3ASztx7o4rF3FMw524"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ATLASWANDERS to record your trip in the background with Path Tracker.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#208AEF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8b1628ff-23e5-4124-8c1f-b8a2b76a61c8"
      }
    },
    "owner": "sathwikms23"
  }
}
