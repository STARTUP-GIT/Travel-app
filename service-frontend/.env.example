# Copy to `.env.local` and fill in. `.env*` is gitignored, so this file is the
# only record of what the app needs.

# REQUIRED. Auth.js signs and verifies every session token with this value.
# Without it Auth.js refuses its own configuration and answers EVERY /api/auth
# request — including the GET /api/auth/session probe that SessionProvider makes
# on page load — with HTTP 500, and no sign-in can ever create a session.
# Generate one with:  npx auth secret
AUTH_SECRET=

# Backend the server actions call. Falls back to NEXT_PUBLIC_API_URL, then to
# the deployed backend, so this only has to be set to point somewhere else.
BACKEND_URL=

# Only read by the browser. Same host as BACKEND_URL.
NEXT_PUBLIC_API_URL=

# Guide Google sign-in. Optional: without it the Google provider is not
# registered at all and only email/password works. Both are required together.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
